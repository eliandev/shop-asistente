# ── Anthropic ────────────────────────────────────────────────────────────────
# Tu llave real: https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-tu-llave-aqui

# Opcional. Por defecto Haiku (rápido y económico). Alternativa: claude-sonnet-5
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Shopify — catálogo en vivo (opcional) ────────────────────────────────────
# Si configurás el dominio, Silvi consulta productos y precios EN VIVO desde tu
# tienda vía el UCP Catalog MCP (público, solo lectura, SIN token).
# Si lo dejás vacío, usa los productos de ejemplo de lib/knowledge-base.ts.
#
# Dominio de tu tienda (sirve el público, ej. mitienda.com, o el interno
# mitienda.myshopify.com):
SHOPIFY_STORE_DOMAIN=

# Opcional. URL del perfil UCP de tu agente (recomendado publicar uno propio
# para producción; por defecto se usa el perfil de ejemplo de shopify.dev):
UCP_AGENT_PROFILE=

# Opcional. RESPALDO por Storefront API (GraphQL): solo se usa si el UCP MCP
# falla Y este token está configurado. Podés dejarlo vacío.
SHOPIFY_STOREFRONT_TOKEN=
# Versión de la API del respaldo (por defecto 2026-04):
SHOPIFY_API_VERSION=2026-04

# ── Monetización — widget Pro ────────────────────────────────────────────────
# Secreto para firmar licencias del widget (generá uno aleatorio largo).
# Las licencias se emiten con: node scripts/generar-licencia.mjs "Marca" dominio
LICENCIA_SECRET=

# ── Firebase — captura de leads (Reto 3) ─────────────────────────────────────
# Consola Firebase -> Configuración del proyecto -> Cuentas de servicio ->
# Generar nueva clave privada (JSON). De ese JSON:
#   project_id -> FIREBASE_PROJECT_ID
#   client_email -> FIREBASE_CLIENT_EMAIL
#   private_key -> FIREBASE_PRIVATE_KEY (UNA línea, saltos como \n)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Automatización de leads — n8n (opcional) ─────────────────────────────────
# Webhook que dispara el workflow "Silvi Lead Engine" (Telegram, ClickUp,
# email, etc.). Cada lead guardado hace un POST con sus datos a esta URL.
# Si se deja vacío, simplemente no se dispara nada.
N8N_WEBHOOK_URL=

# ── Demo "Criterio" — Chat Trigger de n8n (público) ──────────────────────────
# URL del Chat Trigger de n8n (termina en /chat) que responde el demo /criterio.
# Es PÚBLICA (se usa desde el navegador), por eso el prefijo NEXT_PUBLIC_.
# En el nodo Chat Trigger de n8n hay que permitir el origen (Allowed Origins).
NEXT_PUBLIC_CRITERIO_CHAT_URL=

# ── Supabase — cuentas, DB y auth (Fase A / SaaS) ────────────────────────────
# Dashboard de Supabase -> Project Settings -> API Keys ("Publishable and secret").
# La PUBLISHABLE key (sb_publishable_…) es pública (va al navegador, segura con RLS).
# La SECRET key (sb_secret_…) es SECRETA: solo servidor, saltea RLS; NUNCA con
# prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# (Compatibilidad: si usaras las keys legacy JWT, también se aceptan como
#  NEXT_PUBLIC_SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY.)

# ── Stripe — billing (Fase A / SaaS) ─────────────────────────────────────────
# Empezá en modo TEST (dashboard.stripe.com -> Developers -> API keys).
# La secret key y el webhook secret son SECRETOS (solo servidor).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pública, va al navegador):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# IDs de precios (Stripe -> Products). Se completan al crear los Products:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
